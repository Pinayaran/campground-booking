									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Correct campground\", () => pm.expect(pm.response.json().data._id).to.eql(pm.environment.get(\"campgroundId\")));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
