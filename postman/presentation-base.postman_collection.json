				"type": "text/javascript",
				"exec": [
					"// Dates used by booking requests (YYYY-MM-DD)",
					"const fmt = d => d.toISOString().slice(0, 10);",
					"const DAY = 24 * 60 * 60 * 1000;",
					"pm.environment.set(\"futureDate\", fmt(new Date(Date.now() + 30 * DAY)));",
					"pm.environment.set(\"pastDate\", fmt(new Date(Date.now() - 2 * DAY)));"
				]
			}
		},
