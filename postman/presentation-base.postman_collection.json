		{
			"name": "03 View campgrounds",
			"item": [
				{
					"name": "Get all campgrounds (public, no login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test(\"Returns a list\", () => pm.expect(json.data).to.be.an(\"array\").that.is.not.empty);",
									"pm.test(\"Each has name, address and tel\", () => json.data.forEach(c => { pm.expect(c).to.have.property(\"name\"); pm.expect(c).to.have.property(\"address\"); pm.expect(c).to.have.property(\"tel\"); }));",
									"//Book the campground with the most spaces so both users fit on the same dates",
									"const pick = json.data.reduce((a, b) => ((b.capacity || 0) > (a.capacity || 0) ? b : a));",
									"pm.environment.set(\"campgroundId\", pick._id);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{URL}}/campgrounds?limit=50",
							"host": [
								"{{URL}}"
							],
							"path": [
								"campgrounds"
							]
						},
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "Get single campground (public)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
