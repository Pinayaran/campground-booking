						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"pm.test(\"Returns a token\", () => pm.expect(json.token).to.be.a(\"string\"));",
									"pm.environment.set(\"newUserToken\", json.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
